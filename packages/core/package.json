{
  "name": "@peerly/core",
  "version": "1.13.1",
  "description": "Peerly's P2P room core \u2014 join encrypted Trystero rooms by high-entropy room codes, with device identity, signing, media, attention, and signed people lists",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XeonFX/Peerly.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./server/bounded-relay": {
      "default": "./server/boundedRelay.mjs"
    },
    "./worker/network-credentials": {
      "default": "./worker/networkCredentials.mjs"
    },
    "./worker/rendezvous": {
      "default": "./worker/rendezvous.mjs"
    },
    "./worker/google-auth": {
      "default": "./worker/googleAuth.mjs"
    },
    "./worker/realtime": {
      "default": "./worker/realtime/index.mjs"
    },
    "./server/coordination": {
      "default": "./server/coordination.mjs"
    },
    "./realtime/protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./realtime/domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./realtime/ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    },
    "./realtime/gateway": {
      "types": "./dist/adapters/durableObject/gatewayRuntime.d.ts",
      "default": "./dist/adapters/durableObject/gatewayRuntime.js"
    },
    "./realtime/gateway-storage": {
      "types": "./dist/adapters/durableObject/sqlGatewayStorage.d.ts",
      "default": "./dist/adapters/durableObject/sqlGatewayStorage.js"
    },
    "./realtime/app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./worker/realtime/gateway": {
      "default": "./worker/realtime/gateway/userGateway.mjs"
    }
  },
  "files": [
    "dist",
    "server",
    "worker",
    "scripts/check-vite-bundle.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@trystero-p2p/core": "^0.25.3",
    "@trystero-p2p/nostr": "^0.25.3",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@trystero-p2p/supabase": "^0.25.3",
    "@trystero-p2p/ws-relay": "^0.25.3",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@trystero-p2p/supabase": {
      "optional": true
    },
    "@trystero-p2p/ws-relay": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "trystero",
    "peerly",
    "room",
    "nostr"
  ]
}
